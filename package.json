{
  "name": "hylink",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "pnpm --filter @hylink/mobile start",
    "android": "pnpm --filter @hylink/mobile android",
    "ios": "pnpm --filter @hylink/mobile ios",
    "web": "pnpm --filter @hylink/mobile web",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "test": "pnpm test:unit && pnpm test:components",
    "test:unit": "pnpm --filter @hylink/domain test",
    "test:components": "pnpm --filter @hylink/ui test"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}

